<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Published to nuget.org as Packet.Bbs.Fbb (the release workflows pack it and nuget.yml pushes
    it), so other packet-net programs, pdn-mailcast first, can forward FBB mail without copying
    this code. It deliberately references nothing else in this repo: Bbs.Core's SQLite and
    Argon2 have no place in a protocol library. PacketText, the header text codec it needs,
    lives here for that reason; Bbs.Mime and Bbs.Smtp reference this project to use it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Packet.Bbs.Fbb</PackageId>
    <Description>FBB BBS forwarding (B1F and B2F compressed, both the calling and the answering side) as a sans-IO session state machine: proposals, FS lines, block framing, LZHUF, the SID, R: lines and B2 objects. From pdn-bbs.</Description>
    <PackageTags>packet-radio;amateur-radio;bbs;fbb;b2f;lzhuf;linbpq</PackageTags>
    <Authors>packet-net</Authors>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/packet-net/pdn-bbs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/packet-net/pdn-bbs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
